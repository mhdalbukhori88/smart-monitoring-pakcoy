# Konfigurasi Secrets untuk Smart Farming Pakcoy
# Salin file ini menjadi .streamlit/secrets.toml (lokal) atau isi di Streamlit Cloud -> App Settings -> Secrets

# 1. Gemini API untuk halaman Asisten Kebun AI
GEMINI_API_KEY = "MASUKKAN_GEMINI_API_KEY_DI_SINI"

# Opsional: override nama model Gemini (default: gemini-2.5-flash, cadangan: gemini-2.5-flash-lite)
# GEMINI_MODEL = "gemini-2.5-flash"
# GEMINI_BACKUP_MODEL = "gemini-2.5-flash-lite"

# 2. Kredensial Administrator Default (sangat disarankan diisi pada deployment publik)
# ADMIN_USERNAME = "admin"
# ADMIN_PASSWORD = "MASUKKAN_PASSWORD_ADMIN_KUAT_MIN_6_KARAKTER"
