# Konfigurasi Gemini API untuk Smart Farming Pakcoy
# Salin file ini menjadi .streamlit/secrets.toml dan isi dengan API key Anda:
# GEMINI_API_KEY = "kunci_api_asli_anda"

GEMINI_API_KEY = "MASUKKAN_GEMINI_API_KEY_DI_SINI"

# Opsional: override nama model Gemini (default: gemini-2.5-flash)
# GEMINI_MODEL = "gemini-2.5-flash"
